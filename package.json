{
  "name": "local-kanban",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/server.js",
    "dev": "concurrently -k -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/server.js",
    "dev:client": "vite",
    "build": "vite build",
    "test:ui": "vitest run",
    "test:api": "node --test test/*.test.js",
    "test": "npm run test:ui && npm run test:api",
    "test:production": "npm run build && node --test test/production.test.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"test/**/*.js\" vite.config.js index.html package.json",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"test/**/*.js\" vite.config.js index.html package.json"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cross-env": "^10.1.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "vite": "^6.4.6",
    "vitest": "^5.1.1"
  }
}
